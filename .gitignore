*.apk
*.ipk
!dist/*.apk
!dist/*.ipk
*.o
*.a
*.zst

# --- логи, бэкапы, мусор ---
*.log
*.bak
*.orig
*.rej
*.tmp
_*_tmp.*

# --- локальные инструменты и ключи, только на машине разработчика ---
/tools/

# --- node / python ---
node_modules/
__pycache__/
*.pyc
